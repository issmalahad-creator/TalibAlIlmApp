/android/app/release

# Contains a live Telegram bot token + Apps Script URLs — never commit.
# Full values are mirrored in Claude's private memory file (see CLAUDE.md)
# so this file can always be reconstructed if lost.
lib/config/app_config.dart

# Phase 79-mushaf: raw MushafDatabase Ligature-Based SVG source set (~760 MB,
# license "Sadaqa-e-Jaria"). Build-time input for tool/extract_mushaf_svg.py
# only — the committed artefact is assets/mushaf/mushaf_layout.json.gz. Keep a
# local copy to regenerate; never commit the raw SVGs.
/MushafDatabase-Ligature-Based-SVG-main_2/
/svg/
/svg2/
/quran-svg-main_3.zip

# Stray local files at repo root — not part of the app source.
/*.xlsx
/22780766_6685158.svg

# Phase G-t (tajwīd): pinned upstream inputs for tool/build_tajweed_rules.py —
# cpfair/quran-tajweed rule spans (CC BY 4.0) + the exact 2017 Tanzil Uthmani
# base text they are offset against. Build-time only; fetch with
# tool/fetch_tajweed_source.sh. The committed artefact is
# assets/quran/corpus/tajweed.json.gz. Never commit the raw upstream files.
/tool/vendor/

# Quranpedia.net data dumps (raw, ~1.15 GB) — build-time input only, per
# docs/quran/QURAN_CORPUS_INTEGRATION.md. The committed artefacts are the
# curated bundled subset under assets/quran/ + the Supabase mirror. NEVER
# commit the raw dumps (licence: keep current via /v1/changes; huge).
/*.zip
/*.json.gz
/mushafs-*.json.gz
/surahs.json.gz
/topics-index.json.gz
/reciters-index.json.gz
/nasekh-book-*.json.gz
/fatwas.json.gz
/Quran-Data-version-2.0.zip

# القارئ الصوتي العام (docs/audio-reader/TODO.md 1.1): صوت Piper المُعاد
# تعبئته لـsherpa_onnx (رخصة MIT، rhasspy/piper-voices via
# csukuangfj/vits-piper-ar_JO-kareem-medium) — ~63 م.ب، بناء-فقط، لا يُلتزَم
# به. جلبه عبر tool/fetch_tts_voice.sh. pubspec.yaml يفترض وجوده محليًا وقت
# البناء فقط، مثل سياسة tool/fetch_tajweed_source.sh أعلاه تمامًا.
/assets/tts/*.onnx
/assets/tts/packs/
/assets/tts/*.onnx.json
/assets/tts/tokens.txt
/assets/tts/espeak-ng-data/
/Quran-Data-version-2.0/

# Private-build secret + built APK copies (tool/build_all_apks.sh)
/.anthropic_key.local
/dist/

# Local reference media / books (analysis inputs, not app assets)
/*.mp4
/كتب/

# Temporary home of stripped corpus dirs during a lite build (tool/build_apk.py)
/.lite_build_backup/
